# --- Deployment (compose) ---
# Image tag: main, sha-<7>, or a release.
GALLERY_VERSION=main
# Where web listens on the host.
GALLERY_BIND=127.0.0.1
GALLERY_PORT=3000
POSTGRES_PASSWORD=

# --- Sign-in ---
# The public URL; also the MCP resource (<url>/mcp) and issuer base.
BETTER_AUTH_URL=https://gallery.example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# A confidential OIDC client in your Keycloak realm, redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/keycloak.
KEYCLOAK_ISSUER=https://auth.example.com/realms/example
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# --- Observability (optional; off when the endpoint is empty) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=gallery

# --- Photo storage (Nextcloud WebDAV) ---
# An app password of the account that holds the files. Everything goes
# under NEXTCLOUD_ROOT in that account's files, nothing outside it.
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_ROOT=gallery

# --- Search by meaning (optional) ---
# COMPOSE_PROFILES=search starts the embed service; EMBED_URL points web at
# it. Leave both empty and search matches names, tags and uploaders only.
COMPOSE_PROFILES=
EMBED_URL=
EMBED_THREADS=2
